# ─── Shared ──────────────────────────────────────────────────────────────
# development | production | test
NODE_ENV=development

# ─── Database (packages/database) ────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/typeform

# ─── Services (packages/services) ────────────────────────────────────────
# >=8 chars in dev, >=32 chars in production
JWT_SECRET=supersecretkey

# Per-IP submission start/complete cap, per 60s window. Default: 30.
RATE_LIMIT_SUBMISSION_PER_MIN=30

# ─── Logger (packages/logger) ────────────────────────────────────────────
# error | warn | info | debug. Defaults: dev=debug, prod=info.
LOGGER_LEVEL=debug

# ─── API server (apps/api) ───────────────────────────────────────────────
PORT=8000
BASE_URL=http://localhost:8000
# Comma-separated origins allowed to send credentialed requests.
# Required when NODE_ENV=production.
CORS_ORIGIN=http://localhost:3000

# ─── Web app (apps/web) ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
