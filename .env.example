# ═══════════════════════════════════════════════════════════════
# Workspace env reference (auto-generated from env-manifest.json)
# Shows DEV defaults. Run `bash setup.sh --prod` for prod overrides.
# ═══════════════════════════════════════════════════════════════

# development | production | test. Forced to production by setup.sh --prod.
# → apps/api/.env, apps/web/.env.local
NODE_ENV=development

# API server port
# → apps/api/.env
PORT=8000

# API origin (no /api or /trpc suffix). In prod, set to backend URL.
# → apps/api/.env
BASE_URL=http://localhost:8000

# Comma-separated allowed origins for credentialed CORS. In prod, set to frontend URL.
# → apps/api/.env
CORS_ORIGIN=http://localhost:3000

# Postgres connection string. Dev uses these localhost defaults; setup.sh --prod prompts for DB user/password and derives this. Host stays localhost — Postgres is bound to 127.0.0.1 by docker-compose.
# → apps/api/.env, packages/database/.env
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/typeform

# JWT signing key. Auto-generated on first setup. Must be >= 32 chars in production.
# → apps/api/.env
JWT_SECRET=<auto-generated>

# Per-IP submission start/complete cap, per 60s window
# → apps/api/.env
RATE_LIMIT_SUBMISSION_PER_MIN=30

# Per-user theme write (create/update/duplicate/publish/etc.) cap, per 60s window
# → apps/api/.env
RATE_LIMIT_THEME_PER_MIN=30

# error | warn | info | debug. setup.sh --prod forces 'info'.
# → apps/api/.env
LOGGER_LEVEL=debug

# tRPC endpoint URL (includes /trpc suffix). Derived from backend URL in prod.
# → apps/web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000/trpc

# Public web origin. In prod, set to frontend URL.
# → apps/web/.env.local
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# nodemailer | resend. Selects the @repo/mailer transport.
# → apps/api/.env, packages/mailer/.env
MAIL_PROVIDER=nodemailer

# Default From: address used by transactional emails.
# → apps/api/.env, packages/mailer/.env
MAIL_FROM=Simple Form <no-reply@simpleform.local>

# Frontend origin used to build links inside email templates. Mirrors NEXT_PUBLIC_APP_ORIGIN.
# → apps/api/.env, packages/mailer/.env
APP_ORIGIN=http://localhost:3000

# SMTP server hostname. Required when MAIL_PROVIDER=nodemailer.
# → apps/api/.env, packages/mailer/.env
SMTP_HOST=localhost

# SMTP server port. 465 with SMTP_SECURE=true for implicit TLS.
# → apps/api/.env, packages/mailer/.env
SMTP_PORT=587

# SMTP auth user. Required when MAIL_PROVIDER=nodemailer.
# → apps/api/.env, packages/mailer/.env
SMTP_USER=user

# SMTP auth password. Required when MAIL_PROVIDER=nodemailer.
# → apps/api/.env, packages/mailer/.env
SMTP_PASS=password

# true → implicit TLS (port 465). false → STARTTLS (port 587).
# → apps/api/.env, packages/mailer/.env
SMTP_SECURE=false

# Resend API key. Required when MAIL_PROVIDER=resend. Get one at https://resend.com/api-keys.
# → apps/api/.env, packages/mailer/.env
RESEND_API_KEY=

